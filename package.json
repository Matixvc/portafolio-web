{
  "name": "portafolio-web",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio profesional de Matias I. Villalobos Cautivo - Unity & XR Developer",
  "scripts": {
    "build": "npm run icons && tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "icons": "node scripts/build-icons.mjs",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "serve": "npx --yes serve .",
    "set-url": "node scripts/set-url.mjs",
    "og": "node scripts/render.mjs og",
    "cv": "node scripts/render.mjs cv"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "tailwindcss": "^3.4.17"
  }
}
